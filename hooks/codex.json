{
  "description": "callbluff for Codex: the agent shows evidence before it says done.",
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${PLUGIN_ROOT}/hooks/adapter.py\" record"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "apply_patch",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${PLUGIN_ROOT}/hooks/adapter.py\" gate acceptance_files"
          },
          {
            "type": "command",
            "command": "python3 \"${PLUGIN_ROOT}/hooks/adapter.py\" gate pilot_first"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${PLUGIN_ROOT}/hooks/adapter.py\" gate acceptance_files"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${PLUGIN_ROOT}/hooks/adapter.py\" record"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${PLUGIN_ROOT}/hooks/adapter.py\" gate execution_check"
          },
          {
            "type": "command",
            "command": "python3 \"${PLUGIN_ROOT}/hooks/adapter.py\" gate false_completion"
          },
          {
            "type": "command",
            "command": "python3 \"${PLUGIN_ROOT}/hooks/adapter.py\" gate unmeasured_claims"
          },
          {
            "type": "command",
            "command": "python3 \"${PLUGIN_ROOT}/hooks/adapter.py\" gate delivery_inventory"
          },
          {
            "type": "command",
            "command": "python3 \"${PLUGIN_ROOT}/hooks/adapter.py\" gate consumer_sweep"
          },
          {
            "type": "command",
            "command": "python3 \"${PLUGIN_ROOT}/hooks/adapter.py\" gate anchor_regression"
          },
          {
            "type": "command",
            "command": "python3 \"${PLUGIN_ROOT}/hooks/adapter.py\" gate duration_claim"
          },
          {
            "type": "command",
            "command": "python3 \"${PLUGIN_ROOT}/hooks/adapter.py\" gate claim_evidence"
          }
        ]
      }
    ]
  }
}
